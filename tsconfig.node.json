{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },

    /* @types/node — Vite 配置、path、import.meta 等 */
    "types": ["node", "vite/client"]
  },
  "include": [
    "vite.config.ts",
    "vite-plugin-api.ts",
    "server/**/*.ts",
    "src/types/ambient/vite-env.d.ts"
  ]
}
