{
  "name": "hello-roamly",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "vite",
    "dev:mobile": "vite --host",
    "seo:generate": "tsx --tsconfig tsconfig.app.json scripts/generate-seo-files.ts",
    "redirects:sync": "tsx --tsconfig tsconfig.app.json scripts/sync-redirects.ts",
    "build": "pnpm run seo:generate && tsc -b && vite build",
    "build:deploy": "pnpm run seo:generate && vite build",
    "build:deploy:capsule": "node scripts/capsule-deploy-build.mjs",
    "build:deploy:holo": "node scripts/holo-deploy-build.mjs",
    "deploy:holo": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy/deploy-holo-oneclick.ps1",
    "deploy:holo:ssh-setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-holo-ssh.ps1",
    "build:deploy:safe": "pnpm run seo:generate && node scripts/deploy-build.mjs",
    "build:promo": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:VITE_APP_MODE='production'; $env:VITE_MAP_DEV_DEMO='0'; $env:VITE_HOME_LAYOUT='launch'; $env:VITE_INVITE_ENABLED='1'; $env:VITE_SHARE_ANALYTICS_ENABLED='1'; pnpm run build:deploy\"",
    "build:ssg": "pnpm run build && pnpm run prerender",
    "prerender": "tsx --tsconfig tsconfig.app.json scripts/prerender-static.ts",
    "build:analyze": "vite build",
    "build:pwa": "vite build",
    "preview": "vite preview",
    "preview:lan": "vite preview --host --port 4173",
    "preview:ssg": "vite preview --port 4173",
    "start:api": "tsx scripts/production-api-server.ts",
    "check:online": "powershell -ExecutionPolicy Bypass -File scripts/check-online.ps1",
    "tencent:setup": "powershell -ExecutionPolicy Bypass -File deploy/tencent-setup.ps1",
    "deploy:tencent": "powershell -ExecutionPolicy Bypass -File deploy/tencent-static.ps1",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{ts,js,cjs,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{ts,js,cjs,json,md}\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:acceptance-week1": "node scripts/acceptance-week1-smoke.mjs",
    "test:week1-auto": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/week1-dev-acceptance.ps1 -NoWait",
    "test:acceptance-week2": "node scripts/acceptance-week2-smoke.mjs",
    "test:acceptance-week3": "node scripts/acceptance-week3-smoke.mjs",
    "test:acceptance-week4": "node scripts/acceptance-week4-smoke.mjs",
    "test:acceptance-week5": "node scripts/acceptance-week5-smoke.mjs",
    "deploy:lighthouse": "powershell -ExecutionPolicy Bypass -File deploy/lighthouse-full.ps1",
    "test:acceptance-week7": "node scripts/acceptance-week7-smoke.mjs",
    "test:smoke-header": "node scripts/smoke-header-routes.mjs",
    "test:smoke-header:local": "node scripts/run-smoke-header-with-preview.mjs",
    "audit:ux": "node scripts/ux-audit.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "precommit": "lint-staged && pnpm run typecheck",
    "verify:precommit": "node scripts/verify-precommit.mjs"
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "^1.0.1",
    "@headlessui/react": "^2.2.10",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.17.14",
    "@react-three/postprocessing": "^2.16.7",
    "@sentry/react": "^9.47.0",
    "@tanstack/react-query": "^5.100.11",
    "@tsparticles/engine": "^4.0.5",
    "@tsparticles/react": "^4.0.5",
    "@tsparticles/slim": "^4.0.5",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.16.1",
    "cesium": "^1.146.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.2.1",
    "framer-motion": "^12.40.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.16.0",
    "mapbox-gl": "^3.24.0",
    "mapillary-js": "^4.1.2",
    "maplibre-gl": "^5.24.0",
    "postprocessing": "^6.39.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^15.0.0",
    "react-map-gl": "^8.1.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "tsparticles": "^4.0.5",
    "ws": "^8.21.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "8.6.18",
    "@storybook/addon-interactions": "8.6.18",
    "@storybook/addon-links": "8.6.18",
    "@storybook/builder-vite": "8.6.18",
    "@storybook/react": "8.6.18",
    "@storybook/react-vite": "8.6.18",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query-devtools": "^5.100.11",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.15",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.185.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.16",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^15.4.3",
    "playwright": "^1.52.0",
    "postcss": "^8.5.16",
    "prettier": "^3.4.2",
    "sass": "^1.102.0",
    "storybook": "8.6.18",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.19.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.7"
  }
}
