# 本地开发：复制本文件为 .env.local（已被 .gitignore 忽略）
# Vercel 部署变量清单见 .env.vercel.example

# =============================================================================
# 客户端变量（VITE_ 前缀 → 会暴露给浏览器）
# =============================================================================

# 上线模式（关闭 Mock AI / 开发演示地图）；本地测试可设 production
# development = 演示 AI（无需 Key）；production = 真实 DeepSeek（必填 Key）
# VITE_APP_MODE=development
# VITE_APP_MODE=production

# 首页布局：launch 推广版（价值主张 + 12 城封面）；plan-a 原紧凑版
# 正式 build 默认 launch；本地 dev 默认 plan-a
# VITE_HOME_LAYOUT=launch
# VITE_HOME_LAYOUT=plan-a

# 首页粒子背景（卡顿时可设 0 关闭，仅保留 CSS 渐变）
# VITE_HOME_PARTICLES=0
# VITE_MAP_DEV_DEMO=0
# 定位失败时自动用济南演示出发地（默认关闭；需要时再设 1）
# VITE_DEMO_ORIGIN_AUTO=0

# 中国版构建目标（默认 CN；全球扩展可设 GLOBAL）
# VITE_MARKET=CN

# 地图（二选一或同时配置；auto 时优先高德）
# 高德（中国版推荐）— https://console.amap.com/dev/key/app
# ① JS API Key + 安全密钥 → 地图展示（首页轨迹墙、/map）
# VITE_AMAP_KEY=你的Web端Key
# VITE_AMAP_SECURITY_CODE=安全密钥
# ② Web 服务 Key → 逆地理编码（地图点击 AI 规划 POST /api/ai/deepseek）
#    可与 ① 相同，或在控制台单独创建「Web服务」类型 Key
# VITE_AMAP_WEB_SERVICE_KEY=您的高德Web服务Key
# 腾讯位置服务（可选；GEOCODE_PROVIDER=tencent 时使用）— https://lbs.qq.com/dev/console/key/manage
# VITE_TENCENT_MAP_KEY=您的腾讯地图Key
# GEOCODE_PROVIDER=amap
# VITE_MAP_PROVIDER=amap
# 百度地图 AK（驾驶舱街景；高德 JSAPI 街景已下线）— https://lbsyun.baidu.com/apiconsole/key
# VITE_BAIDU_MAP_AK=你的百度浏览器端AK
# Mapillary（驾驶舱「连续序列」；有覆盖的城市/海外更稳）
# 1) 打开 https://www.mapillary.com/dashboard/developers 创建应用
# 2) 复制 Access Token（形如 MLY|...）写入本机 .env.local：
# VITE_MAPILLARY_ACCESS_TOKEN=MLY|你的token
# 3) 改完后必须重启 Vite；生产构建前也要写入构建机环境（会打进前端包）
# 未配置时驾驶舱会提示 mapillaryConfigError，可继续用视频/百度
# 驾驶舱云端投稿审核（可选；不配则自动通过）
# DRIVE_VIDEOS_ADMIN_KEY=change-me
# DRIVE_VIDEOS_AUTO_APPROVE=1
# 生产注意：nginx 需允许大文件上传，例如 client_max_body_size 80m;
# 轨迹墙底图（默认 amap://styles/normal 显示地名；勿用 darkblue）
# VITE_AMAP_TRAIL_STYLE=amap://styles/normal

# 支付（中国版预留；商户私钥仅放后端，见 .env.vercel.example）
# VITE_PAYMENT_UI_ENABLED=1
# VITE_PAYMENT_ALIPAY_ENABLED=1
# VITE_PAYMENT_WECHAT_ENABLED=1

# 内容安全（中国版；云审密钥仅后端）
# VITE_CONTENT_MODERATION_ENABLED=1
# VITE_CONTENT_MODERATION_STRICT=1
# VITE_CONTENT_MODERATION_DEMO_BLOCK=1

# 国内 CDN（构建前设置；OSS/COS/七牛 等）
# VITE_CDN_BASE=https://cdn.example.com/
# VITE_IMAGE_CDN=https://your-image.example.com/proxy?url={url}
# VITE_USE_CHINA_CDN=1
# VITE_ALLOW_FOREIGN_IMAGE_PROXY=0

# 分享效果统计（默认开启；设为 0 关闭）
# VITE_SHARE_ANALYTICS_ENABLED=1

# 邀请好友得奖励（中国版默认开启）
# VITE_INVITE_ENABLED=1

# Mapbox 公开 token — https://account.mapbox.com/access-tokens/
# VITE_MAPBOX_TOKEN=pk.你的_mapbox_token
# 轨迹墙暗黑样式（可选；默认 mapbox://styles/mapbox/dark-v11）
# 建议在 Mapbox Studio 基于 Dark 模板隐藏道路/标签后填入样式 URL
# VITE_MAPBOX_TRAIL_STYLE=mapbox://styles/你的用户名/你的样式ID

# 开发演示地图（无需 Key；设为 0 关闭）
# VITE_MAP_DEV_DEMO=1

# 站点根 URL（SEO：canonical / og:url；本地可省略）
# VITE_SITE_URL=http://localhost:5173

# 自建 API（配置后攻略走 GET /guides；未配置则用 src/data/demoGuides）
# VITE_API_BASE_URL=https://api.example.com

# 开发用 Bearer（axios 自动注入；勿提交真实密钥）
# VITE_API_TOKEN=your_dev_bearer_token

# Sentry 错误监控 — https://sentry.io （生产建议配置；DSN 可公开但勿泄露 auth token）
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# VITE_SENTRY_ENVIRONMENT=development
# VITE_SENTRY_RELEASE=hello-roamly@0.0.0
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# VITE_SENTRY_ENABLED=1
# VITE_SENTRY_DEBUG=1

# DeepSeek AI — https://platform.deepseek.com/api_keys
# 未配置时 /ai 为演示回复；AI蜗牛 POST /api/ai/generate-guide 优先读下方服务端 Key
# VITE_DEEPSEEK_API_KEY=sk-你的_deepseek_key
# VITE_DEEPSEEK_BASE_URL=https://api.deepseek.com
# VITE_DEEPSEEK_MODEL=deepseek-chat

# =============================================================================
# 构建 / 预渲染（终端与 CI，非 VITE_）
# =============================================================================
# SKIP_PRERENDER=1
# PRERENDER_PORT=4173

# =============================================================================
# 服务端专用（无 VITE_ 前缀；仅 Node / Vercel Serverless / 自建 API）
# 当前 SPA 不直连数据库，由后端持有并在服务端使用下列变量
# =============================================================================
# DATABASE_URL=postgresql://user:password@localhost:5432/roamly
# API_SECRET=change-me
# 地图点击 AI 规划（POST /api/ai/deepseek）逆地理；可与 VITE_AMAP_WEB_SERVICE_KEY 相同
# AMAP_WEB_SERVICE_KEY=
# TENCENT_MAP_KEY=
# GEOCODE_PROVIDER=amap
# AI 规划 / AI蜗牛（优先服务端 Key，不暴露给浏览器更安全）
# DEEPSEEK_API_KEY=sk-xxx

# 第六周：云端流式普通话 ASR（可选；未配置时 Edge 走本地 Whisper）
# 讯飞实时语音（推荐，有免费额度）— https://console.xfyun.cn/
# IFLYTEK_APP_ID=
# IFLYTEK_API_KEY=
# IFLYTEK_API_SECRET=
# 火山引擎（可选）— https://console.volcengine.com/speech
# VOLC_SPEECH_APP_ID=
# VOLC_SPEECH_ACCESS_TOKEN=
# SPEECH_ASR_PROVIDER=local-whisper
# SPEECH_ASR_PROVIDER=iflytek
