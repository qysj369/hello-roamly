# =============================================================================
# Vercel 环境变量模板（Git 自动部署时在 Vercel 控制台填写，见 deploy/github-vercel.md）
# =============================================================================
# 复制到：Project → Settings → Environment Variables
# 不要提交含真实密钥的 .env 文件到 Git
# =============================================================================
#
# 作用域建议：
#   Production  — 线上
#   Preview     — PR 预览（可与 Production 相同或留空演示模式）
#   Development — 本地 vercel dev（可选）
#
# 前缀说明：
#   VITE_*     会打进前端 bundle，浏览器可见 → 仅放「可公开」或「必须在前端用」的配置
#   无 VITE_   仅构建脚本 / Serverless 可见 → 数据库、服务端 API 密钥放这里
# =============================================================================

# --- SEO / 站点（Production 推荐必填）---
# canonical、og:url、sitemap 绝对地址；填你的 Vercel 域名或自定义域
VITE_SITE_URL=https://your-project.vercel.app

# --- 市场（默认中国版）---
# VITE_MARKET=CN

# --- 地图（/map 页；二选一或同时配置，auto 时优先高德）---
# 高德（中国版推荐）— Web Key + 安全密钥
 VITE_AMAP_KEY=e3767a6e995de0d27e5acdb3c419b5bf
 VITE_AMAP_SECURITY_CODE=2c993fb327ffde42172afa0193e3970b
VITE_MAP_PROVIDER=amap
#

# --- 国内 CDN（Production 推荐）---
# 将 dist 同步到 OSS/COS 后填写（末尾带 /）
# VITE_CDN_BASE=https://cdn.your-domain.com/
# 图片处理 / 镜像（支持 {url} 占位）
# VITE_IMAGE_CDN=https://img.your-domain.com/proxy?url={url}

# --- 内容安全（服务端对接云审，勿加 VITE_ 前缀）---
# CONTENT_MODERATION_PROVIDER=aliyun
# ALIYUN_CONTENT_SECURITY_ACCESS_KEY=
# ALIYUN_CONTENT_SECURITY_SECRET=
# TENCENT_CMS_SECRET_ID=
# TENCENT_CMS_SECRET_KEY=
# VITE_CONTENT_MODERATION_ENABLED=1
# VITE_CONTENT_MODERATION_STRICT=1
# VITE_CONTENT_MODERATION_DEMO_BLOCK=1

# --- 支付（服务端密钥，勿加 VITE_ 前缀）---
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# WECHAT_PAY_MCH_ID=
# WECHAT_PAY_API_V3_KEY=
# WECHAT_PAY_APP_ID=
# 客户端仅开关（Preview 可全开 1 做联调）：
# VITE_PAYMENT_UI_ENABLED=1
# VITE_PAYMENT_ALIPAY_ENABLED=1
# VITE_PAYMENT_WECHAT_ENABLED=1

# --- 后端 API（可选）---
# 配置后攻略等走真实接口；未配置则使用仓库内 demo 数据
VITE_API_BASE_URL=https://api.your-backend.com
# 开发/演示用 Bearer；生产更推荐仅服务端持有密钥，见 DATABASE_URL 说明
VITE_API_TOKEN=

# --- Sentry 错误监控（Production 推荐）---
# DSN 可放在前端；Auth Token 仅用于 CI 上传 source map，勿加 VITE_ 前缀
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# VITE_SENTRY_ENVIRONMENT=production
# VITE_SENTRY_RELEASE=hello-roamly@1.0.0
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_AUTH_TOKEN=sntrys_xxx

# --- AI 旅行顾问（可选）---
# 未配置时 /ai 为本地演示回复
# 注意：VITE_ 前缀会暴露在前端，生产环境更安全的做法是由后端代理 DeepSeek
VITE_DEEPSEEK_API_KEY=
VITE_DEEPSEEK_BASE_URL=https://api.deepseek.com
VITE_DEEPSEEK_MODEL=deepseek-chat

# --- 构建 / SSG（可选）---
# 设为 1 可跳过 Playwright 预渲染，加快部署（SEO 仅依赖客户端 meta）
# SKIP_PRERENDER=0

# =============================================================================
# 服务端专用（不要加 VITE_ 前缀）
# 当前仓库为纯前端 SPA，下列变量供「自建 API」或「Vercel Serverless」使用，
# 前端通过 VITE_API_BASE_URL 调用后端，由后端连接数据库。
# =============================================================================

# PostgreSQL（示例：Neon / Supabase / Vercel Postgres）
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# 无连接池直连（部分 ORM 迁移用）
# DATABASE_URL_UNPOOLED=postgresql://user:password@host:5432/dbname?sslmode=require

# 通用服务端密钥（仅 api/*.ts Serverless 内使用，勿暴露给浏览器）
# API_SECRET=your-random-secret
# JWT_SECRET=your-jwt-signing-secret

# 第三方服务（服务端调用）
# DEEPSEEK_API_KEY=sk-xxx
# MAPBOX_SECRET_TOKEN=sk.xxx
