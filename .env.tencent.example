# Tencent Cloud deploy env (copy values to PowerShell before build/deploy)
# Do NOT commit real secrets to Git.

# Your production domain (must match DNS + CDN + Amap whitelist)
VITE_SITE_URL=https://helloroamly.com

# Promotion launch defaults (deploy/load-deploy-env.ps1 also forces these)
VITE_APP_MODE=production
VITE_MAP_DEV_DEMO=0
VITE_HOME_LAYOUT=launch
VITE_INVITE_ENABLED=1
VITE_SHARE_ANALYTICS_ENABLED=1

# Amap (from console.amap.com)
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=
VITE_MAP_PROVIDER=amap

# Optional: serve JS/CSS from CDN subdomain after CDN is ready
# VITE_CDN_BASE=https://cdn.你的域名.com/

# COS upload (configure coscmd separately, not in frontend env)
# One-time: coscmd config -a <SecretId> -s <SecretKey> -b <BucketName-APPID> -r ap-beijing
# TENCENT_SECRET_ID=
# TENCENT_SECRET_KEY=
# TENCENT_COS_BUCKET=hello-roamly-1250000000
# TENCENT_COS_REGION=ap-beijing
